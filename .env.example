# ============================================================
# Variáveis de Ambiente - Plataforma de Streaming de Eventos
# Ambiente de Desenvolvimento Local
# ============================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Uso: cp .env.example .env
#
# ⚠️ AVISO DE SEGURANÇA: NUNCA commite o arquivo .env gerado.
# Ele já está ignorado no .gitignore, mantenha assim.
# ============================================================

# ==========================================================
# BANCO DE DADOS (PostgreSQL)
# ==========================================================
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming123
POSTGRES_DB=streaming_events

# ==========================================================
# INFRAESTRUTURA DE MENSAGERIA (Kafka KRaft)
# ==========================================================
# ID único para o cluster KRaft (Necessário por não usarmos Zookeeper).
# Para gerar um novo em caso de reset total: `kafka-storage random-uuid`
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ==========================================================
# OBSERVABILIDADE (Grafana, OTel, Logs)
# ==========================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Controle dinâmico de logs para os microsserviços Spring Boot
# Mude para DEBUG ou TRACE para troubleshooting profundo e reinicie os containers
APP_LOG_LEVEL=INFO

# ==========================================================
# TUNING DA JVM (Microsserviços)
# ==========================================================
# Permite sobrescrever os limites de memória da JVM localmente se sua máquina tiver pouca RAM
# Exemplo: -XX:MaxRAMPercentage=50.0
# JAVA_TOOL_OPTIONS_OVERRIDE=