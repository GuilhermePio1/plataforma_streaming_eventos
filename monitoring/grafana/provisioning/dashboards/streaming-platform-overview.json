{
  "annotations": {
    "list": []
  },
  "description": "Visão geral da Plataforma de Streaming de Eventos",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Saúde dos Serviços",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=~\"ingestion-service|stream-processing-service|persistence-service|query-service|notification-service\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "title": "Status dos Serviços",
      "type": "stat"
    },
    {
      "type": "logs",
      "title": "Logs de Erro Recentes",
      "id": 10,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "targets": [
        {
          "expr": "{service=~\"^.*-service$\"} |~ \"(?i)error|exception\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Throughput e Latência",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5, "spanNulls": true },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"ingestion-service\"}[1m]))",
          "legendFormat": "Ingestão (req/s)"
        }
      ],
      "title": "Taxa de Ingestão de Eventos",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5, "spanNulls": true },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\".*service\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\".*service\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\".*service\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - P99"
        }
      ],
      "title": "Latência por Percentil",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Kafka",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": true },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(kafka_consumer_group_lag) by (consumergroup)",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "title": "Consumer Lag por Serviço",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1, "spanNulls": true },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(kafka_producer_record_send_total{job=~\".*service\"}[5m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ],
      "title": "Produção Kafka (records/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Erros e Resiliência",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": true },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\", job=~\".*service\"}[5m])) by (job)",
          "legendFormat": "{{job}} - 5xx"
        }
      ],
      "title": "Taxa de Erros (5xx) por Serviço",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "CLOSED": { "color": "green", "text": "CLOSED" },
                "HALF_OPEN": { "color": "yellow", "text": "HALF_OPEN" },
                "OPEN": { "color": "red", "text": "OPEN" }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 7,
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{job=~\".*service\"}",
          "legendFormat": "{{job}} - {{name}}"
        }
      ],
      "title": "Estado dos Circuit Breakers",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "JVM e Recursos",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": true },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "id": 8,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=~\".*service\"}",
          "legendFormat": "{{job}} - Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", job=~\".*service\"}",
          "legendFormat": "{{job}} - Heap Max"
        }
      ],
      "title": "Uso de Memória Heap (JVM)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "spanNulls": true },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 9,
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\".*service\"}",
          "legendFormat": "{{job}} - Live Threads"
        },
        {
          "expr": "jvm_threads_states_threads{state=\"virtual\", job=~\".*service\"}",
          "legendFormat": "{{job}} - Virtual Threads"
        }
      ],
      "title": "Threads (JVM)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["streaming", "platform", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Streaming Platform - Overview",
  "uid": "streaming-platform-overview",
  "version": 1
}